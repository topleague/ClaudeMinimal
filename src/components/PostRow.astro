---
interface WPPost {
  uri: string;
  title: string;
  excerpt?: string;
  date: string;
  categories?: { nodes: { name: string; uri: string }[] };
}

interface Props {
  post: WPPost;
}

const { post } = Astro.props;

const stamp = new Date(post.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});

// WordPress excerpts come back as HTML — strip tags for the plain-text preview.
const plainExcerpt = (post.excerpt || '').replace(/<[^>]+>/g, '').trim();
const tags = post.categories?.nodes ?? [];
---

<a
  href={post.uri}
  class="group border-line hover:border-signal grid grid-cols-[3.5rem_1fr_auto] items-center gap-4 border-b py-5 transition-colors sm:grid-cols-[4.5rem_1fr_auto] sm:gap-6"
>
  <span class="text-ink-soft font-mono text-xs">{stamp}</span>

  <span class="min-w-0">
    <span
      class="font-display text-ink group-hover:text-signal block truncate text-lg transition-colors"
    >
      {post.title}
    </span>
    {
      plainExcerpt && (
        <span class="text-ink-soft hidden truncate text-sm sm:block">{plainExcerpt}</span>
      )
    }
  </span>

  <span class="flex items-center gap-4">
    {
      tags.length > 0 && (
        <span class="text-ink-soft hidden font-mono text-[11px] md:block">
          {tags
            .slice(0, 2)
            .map((t) => t.name)
            .join(' · ')}
        </span>
      )
    }
    <span
      aria-hidden="true"
      class="text-ink-soft group-hover:text-signal transition-all group-hover:translate-x-1"
    >
      →
    </span>
  </span>
</a>
