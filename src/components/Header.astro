---
import ThemeToggle from '@/components/ThemeToggle.astro';
import { SITE } from '@/site.config';
import { getNavigationMenu } from '@/lib/wordpress.js';

const currentPath = Astro.url.pathname;

// Pulls the WordPress "header-navigation" Navigation block. If that menu
// doesn't exist yet (or the WordPress site is briefly unreachable at build
// time), fall back to a couple of safe defaults instead of failing the build.
interface NavLink {
  label: string;
  url: string;
}

let wpLinks: NavLink[] = [];
try {
  wpLinks = await getNavigationMenu('header-navigation');
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.warn('Could not load WordPress navigation menu:', message);
}

const fallbackLinks: NavLink[] = [
  { label: 'Home', url: '/' },
  { label: 'About', url: '/about' },
];

const links = wpLinks.length > 0 ? wpLinks : fallbackLinks;
---

<header class="border-line bg-paper/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="font-display text-ink text-lg font-medium">
      {SITE.name}
    </a>

    <nav class="flex items-center gap-5" aria-label="Primary">
      {
        links.map((link) => {
          const href = link.url;
          const isActive = currentPath === href || currentPath.startsWith(`${href}/`);
          return (
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'font-mono text-xs tracking-wide uppercase transition-colors',
                isActive ? 'text-signal' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
      <ThemeToggle />
    </nav>
  </div>
</header>
