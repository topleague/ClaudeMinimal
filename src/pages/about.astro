---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { SITE } from '@/site.config';

const tools = ['TypeScript', 'Astro', 'React', 'Figma', 'Tailwind CSS', 'Node.js'];
---

<BaseLayout title="About" description={`A bit about ${SITE.name} and how they work.`}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-24 sm:pt-24">
    <p class="text-ink-soft mb-6 font-mono text-xs tracking-[0.2em] uppercase">About</p>

    <h1 class="font-display text-ink max-w-xl text-3xl font-medium sm:text-4xl">
      {SITE.role}.
    </h1>

    <div class="prose prose-sm sm:prose-base mt-8 max-w-xl">
      <p>Thanks for stopping by 🎉</p>
      <p>I’m the founder of Top League Technologies Pvt Ltd, where we specialize in content writing, SEO, WordPress Development, and social media services.</p>
      <p>I’ve been active in the digital marketing space since 2006. Over the years, I’ve watched the industry evolve from keyword-focussed SEO to today’s GEO (Generative Engine Optimization).</p>
      <p>My experience spans hundreds of clients across the globe, and I love helping businesses unlock their potential through smart and effective digital strategies.</p>
      <p>I can build you a sleek WordPress site, create useful content, and devise an SEO plan that gets results. My approach combines the latest trends in web design with time-tested marketing strategies to help you stand out online.</p>
      <p>If you’re ready to take your business to the next level, let’s chat. You can connect with me on Twitter or simply drop me a line via the contact page.</p>
      <p>Here are some blog posts you may want to read to evaluate my skills:</p>

<div class="text-signal mt-4 inline-flex items-center gap-2 font-mono hover:underline">
<ul><li><a href="https://topleaguetech.com/category/content-marketing">Content Writing</a></li><li><a href="https://topleague.website/blog/">WordPress Development</a></li><li><a href="https://susanta.com/category/seo/">Search Engine Optimization</a>(SEO)</li></ul>
</div>
    </div>

    <div class="mt-10">
      <p class="text-ink-soft mb-3 font-mono text-xs tracking-[0.2em] uppercase">Tools</p>
      <ul class="flex flex-wrap gap-2">
        {
          tools.map((tool) => (
            <li class="border-line text-ink-soft rounded-full border px-3 py-1 font-mono text-xs">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>

    <Button href={`mailto:${SITE.email}`} class="mt-10">Get in touch</Button>
  </section>
</BaseLayout>
